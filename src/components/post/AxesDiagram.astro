---
// A (3, 4) array with its two axes, and what sum(axis=0) / sum(axis=1) collapse it to.
const rows = 3;
const cols = 4;
const cw = 52;
const ch = 40;
const x0 = 96;
const y0 = 56;
const value = (r: number, c: number) => r * cols + c;
const colSums = Array.from({ length: cols }, (_, c) =>
  Array.from({ length: rows }, (_, r) => value(r, c)).reduce((a, b) => a + b, 0));
const rowSums = Array.from({ length: rows }, (_, r) =>
  Array.from({ length: cols }, (_, c) => value(r, c)).reduce((a, b) => a + b, 0));
const hlCol = 1;
const hlRow = 1;
const bottomY = y0 + rows * ch + 30;
const rightX = x0 + cols * cw + 36;
---

<figure class="diagram">
  <svg viewBox="0 0 440 282" role="img"
    aria-label="A 3 by 4 array holding 0 to 11. Axis 0 runs down the rows, axis 1 runs across the columns. Summing over axis 0 adds down each column and leaves 4 numbers: 12, 15, 18, 21. Summing over axis 1 adds across each row and leaves 3 numbers: 6, 22, 38.">
    <!-- axis 1: across -->
    <text class="lbl" x={x0 + (cols * cw) / 2} y="22" text-anchor="middle">axis 1 (across the columns)</text>
    <line class="axis" x1={x0} y1="34" x2={x0 + cols * cw - 6} y2="34" />
    <polygon class="head" points={`${x0 + cols * cw},34 ${x0 + cols * cw - 9},29 ${x0 + cols * cw - 9},39`} />

    <!-- axis 0: down -->
    <text class="lbl" transform={`translate(52 ${y0 + (rows * ch) / 2}) rotate(-90)`} text-anchor="middle">axis 0 (down the rows)</text>
    <line class="axis" x1="70" y1={y0} x2="70" y2={y0 + rows * ch - 6} />
    <polygon class="head" points={`70,${y0 + rows * ch} 65,${y0 + rows * ch - 9} 75,${y0 + rows * ch - 9}`} />

    <!-- the array -->
    {Array.from({ length: rows }, (_, r) =>
      Array.from({ length: cols }, (_, c) => (
        <g>
          <rect class={c === hlCol ? "cell hl" : "cell"} x={x0 + c * cw} y={y0 + r * ch} width={cw} height={ch} />
          <text class="num" x={x0 + c * cw + cw / 2} y={y0 + r * ch + ch / 2 + 5} text-anchor="middle">{value(r, c)}</text>
        </g>
      )))}
    <rect class="row-outline" x={x0 - 3} y={y0 + hlRow * ch + 2} width={cols * cw + 6} height={ch - 4} rx="4" />

    <!-- sum(axis=0): one number per column -->
    <line class="axis" x1={x0 + hlCol * cw + cw / 2} y1={y0 + rows * ch + 5} x2={x0 + hlCol * cw + cw / 2} y2={bottomY - 9} />
    <polygon class="head" points={`${x0 + hlCol * cw + cw / 2},${bottomY - 3} ${x0 + hlCol * cw + cw / 2 - 5},${bottomY - 11} ${x0 + hlCol * cw + cw / 2 + 5},${bottomY - 11}`} />
    {colSums.map((s, c) => (
      <g>
        <rect class={c === hlCol ? "cell hl" : "cell result"} x={x0 + c * cw} y={bottomY} width={cw} height={ch} />
        <text class="num" x={x0 + c * cw + cw / 2} y={bottomY + ch / 2 + 5} text-anchor="middle">{s}</text>
      </g>
    ))}
    <text class="lbl" x={x0 + (cols * cw) / 2} y={bottomY + ch + 24} text-anchor="middle">a.sum(axis=0)  →  shape (4,)</text>

    <!-- sum(axis=1): one number per row -->
    <text class="lbl" x={rightX + cw / 2} y={y0 - 10} text-anchor="middle">a.sum(axis=1)</text>
    <line class="axis" x1={x0 + cols * cw + 6} y1={y0 + hlRow * ch + ch / 2} x2={rightX - 9} y2={y0 + hlRow * ch + ch / 2} />
    <polygon class="head" points={`${rightX - 3},${y0 + hlRow * ch + ch / 2} ${rightX - 11},${y0 + hlRow * ch + ch / 2 - 5} ${rightX - 11},${y0 + hlRow * ch + ch / 2 + 5}`} />
    {rowSums.map((s, r) => (
      <g>
        <rect class={r === hlRow ? "cell result row-hit" : "cell result"} x={rightX} y={y0 + r * ch} width={cw} height={ch} />
        <text class="num" x={rightX + cw / 2} y={y0 + r * ch + ch / 2 + 5} text-anchor="middle">{s}</text>
      </g>
    ))}
    <text class="lbl" x={rightX + cw / 2} y={y0 + rows * ch + 20} text-anchor="middle">shape (3,)</text>
  </svg>
  <figcaption>The axis you name is the one that disappears. <code>axis=0</code> adds down each column (shaded); <code>axis=1</code> adds across each row (outlined).</figcaption>
</figure>

<style>
  .diagram {
    margin: 28px auto;
    max-width: 520px;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cell {
    fill: var(--bg-secondary);
    stroke: var(--border-medium);
    stroke-width: 1;
  }

  .cell.result {
    fill: var(--bg-tertiary);
  }

  .cell.hl {
    fill: var(--hl-soft);
    stroke: var(--hl);
  }

  .cell.row-hit {
    stroke: var(--text-primary);
    stroke-dasharray: 4 3;
    stroke-width: 1.5;
  }

  .row-outline {
    fill: none;
    stroke: var(--text-primary);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--text-primary);
  }

  .lbl {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--text-secondary);
  }

  .axis {
    stroke: var(--text-secondary);
    stroke-width: 1.5;
  }

  .head {
    fill: var(--text-secondary);
  }

  figcaption {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
    text-align: center;
  }
</style>
