---
// (3, 1) + (1, 4) -> (3, 4): each size-1 axis is stretched (dashed copies) to match the other.
const a = [0, 10, 20]; // (3, 1)
const b = [1, 2, 3, 4]; // (1, 4)
const cw = 30;
const ch = 28;
const top = 40;
const grids = [
  { x: 8, label: "a (3, 1)", value: (r: number, c: number) => a[r], real: (r: number, c: number) => c === 0 },
  { x: 160, label: "b (1, 4)", value: (r: number, c: number) => b[c], real: (r: number, c: number) => r === 0 },
  { x: 312, label: "a + b (3, 4)", value: (r: number, c: number) => a[r] + b[c], real: () => true },
];
---

<figure class="diagram">
  <svg viewBox="0 0 448 160" role="img"
    aria-label="Broadcasting a column of shape (3, 1) holding 0, 10, 20 against a row of shape (1, 4) holding 1, 2, 3, 4. The column is stretched across 4 columns and the row is stretched down 3 rows, both shown dashed, and they add to a (3, 4) result: 1 2 3 4, 11 12 13 14, 21 22 23 24.">
    <text class="lbl" x="224" y="20" text-anchor="middle">dashed cells are stretched copies (virtual: no extra memory)</text>
    {grids.map((g) => (
      <g>
        {[0, 1, 2].map((r) => [0, 1, 2, 3].map((c) => (
          <g>
            <rect class={g.real(r, c) ? "cell" : "cell ghost"} x={g.x + c * cw} y={top + r * ch} width={cw} height={ch} />
            <text class={g.real(r, c) ? "num" : "num ghost-num"} x={g.x + c * cw + cw / 2} y={top + r * ch + ch / 2 + 5} text-anchor="middle">{g.value(r, c)}</text>
          </g>
        )))}
        <text class="code" x={g.x + 2 * cw} y={top + 3 * ch + 24} text-anchor="middle">{g.label}</text>
      </g>
    ))}
    <text class="op" x="144" y={top + 1.5 * ch + 7} text-anchor="middle">+</text>
    <text class="op" x="296" y={top + 1.5 * ch + 7} text-anchor="middle">=</text>
  </svg>
  <figcaption>The column is copied across, the row is copied down, then the two (3, 4) grids are added element by element.</figcaption>
</figure>

<style>
  .diagram {
    margin: 28px auto;
    max-width: 560px;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cell {
    fill: var(--hl-soft);
    stroke: var(--hl);
    stroke-width: 1;
  }

  .cell.ghost {
    fill: none;
    stroke: var(--border-medium);
    stroke-dasharray: 3 3;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text-primary);
  }

  .ghost-num {
    fill: var(--text-muted);
  }

  .code {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text-primary);
  }

  .op {
    font-family: var(--font-mono);
    font-size: 20px;
    fill: var(--text-secondary);
  }

  .lbl {
    font-family: var(--font-sans);
    font-size: 12px;
    fill: var(--text-secondary);
  }

  figcaption {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
    text-align: center;
  }
</style>
