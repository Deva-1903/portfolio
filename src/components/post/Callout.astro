---
// A boxed aside inside a post. Children are Markdown (leave blank lines around them in MDX).
interface Props {
  type?: "note" | "tip" | "warn" | "summary";
  title?: string;
}
const { type = "note", title } = Astro.props;
const label = { note: "Note", tip: "Tip", warn: "Gotcha", summary: "Summary" }[type];
---

<aside class={`callout callout-${type}`} aria-label={title ?? label}>
  <p class="callout-title">{title ?? label}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 28px 0;
    padding: 16px 20px 6px;
    border: 1px solid var(--border-light);
    border-left: 3px solid var(--hl);
    border-radius: 0 10px 10px 0;
    background: var(--bg-secondary);
  }

  .callout-summary {
    border-left-width: 1px;
    border-radius: 10px;
    background: var(--hl-soft);
    border-color: var(--border-medium);
  }

  .callout-warn {
    border-left-style: dashed;
    border-left-color: var(--text-primary);
  }

  .callout-title {
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .callout-body :global(p),
  .callout-body :global(li) {
    font-size: 15.5px;
    line-height: 1.65;
  }

  .callout-body :global(ul) {
    padding-left: 20px;
  }

  .callout-body :global(li) {
    margin-bottom: 6px;
  }
</style>
